# ──────────────────────────────────────────────────────────────────────────
# AnsCloud environment configuration — copy to .env and fill in real values.
# ──────────────────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL via Neon) ─────────────────────────────────────────
# Get free Postgres at https://neon.tech (no credit card required).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Login Credentials ─────────────────────────────────────────────────────
ANSCLOUD_LOGIN_EMAIL=info@anangsetya.my.id
# Generate hash: bun -e "import bcrypt from 'bcryptjs'; console.log(bcrypt.hashSync('PASSWORD', 12))"
# IMPORTANT: escape every '$' as '\$' in the hash!
ANSCLOUD_LOGIN_PASSWORD_HASH="\$2b\$12\$REPLACE_WITH_YOUR_BCRYPT_HASH"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
NEXTAUTH_URL=https://drive.anangsetya.my.id

# ─── Supabase Storage (for file blobs) ──────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Google Drive OAuth (OPTIONAL) ────────────────────────────────────────
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx
# ANSCLOUD_PUBLIC_URL=https://drive.anangsetya.my.id
